# .dockerignore for WebApiShop

# Build outputs
**/bin/
**/obj/
**/out/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# NuGet packages
packages/
*.nupkg
*.snupkg

# Git files
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md

# Docker files (avoid recursion)
Dockerfile*
docker-compose*
.dockerignore

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Node modules (if any)
node_modules/

# Environment files
.env
.env.local
.env.production